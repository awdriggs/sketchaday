---
layout: none
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ site.url }}{{ site.baseurl }}/feed.xml" rel="self" type="application/atom+xml" />
  <link href="{{ site.url }}{{ site.baseurl }}/" rel="alternate" type="text/html" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ site.url }}{{ site.baseurl }}/feed.xml</id>
  <title type="html">{{ site.title | xml_escape }}</title>
  {% if site.description %}<subtitle>{{ site.description | xml_escape }}</subtitle>{% endif %}

  {% for post in site.posts limit:10 %}
  <entry>
    <title type="html">{{ post.title | xml_escape }}</title>
    <link href="{{ post.url | prepend: site.baseurl | prepend: site.url }}" rel="alternate" type="text/html" title="{{ post.title | xml_escape }}" />
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.date | date_to_xmlschema }}</updated>
    <id>{{ post.id | prepend: site.baseurl | prepend: site.url }}</id>
    <content type="html" xml:base="{{ post.url | prepend: site.baseurl | prepend: site.url }}"><![CDATA[{% if post.thumbnail %}<img src="{{ post.thumbnail }}" alt="{{ post.title | xml_escape }}" style="max-width:100%;display:block;margin:0 auto;" />{% endif %}<p style="text-align:center;font-family:sans-serif;margin-top:1em;"><a href="{{ post.url | prepend: site.baseurl | prepend: site.url }}">Open in a browser for interactive sketch</a></p>]]></content>
    <author><name>{{ site.author | default: "" }}</name></author>
  </entry>
  {% endfor %}
</feed>
